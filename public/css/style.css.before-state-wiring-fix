/* =========================================================
   THEO COMPOSER V2 — CLEAN DESIGN
   ========================================================= */

.composer-v2 {
  width: 100%;
  margin: 0;
  padding: 12px;
  box-sizing: border-box;
}

.composer-shell {
  position: relative;
  width: 100%;
  min-height: 58px;
  border: 1px solid rgba(120, 140, 180, 0.28);
  border-radius: 20px;
  background: rgba(16, 22, 38, 0.96);
  box-sizing: border-box;
  overflow: hidden;
}

.composer-content {
  width: 100%;
  padding: 14px 16px 4px;
  box-sizing: border-box;
}

#message-input {
  width: 100%;
  min-height: 24px;
  max-height: 180px;
  margin: 0;
  padding: 0;
  border: 0;
  outline: 0;
  resize: none;
  overflow-y: auto;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.45;
  box-sizing: border-box;
}

#message-input::placeholder {
  opacity: 0.55;
}

.composer-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 46px;
  padding: 6px 10px 10px;
  box-sizing: border-box;
}

.composer-spacer {
  flex: 1;
}

.composer-icon-button,
.composer-aira-button {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  padding: 0;
  margin: 0;
  cursor: pointer;
  color: #3b82f6;
}

.composer-icon-button:active,
.composer-aira-button:active {
  transform: scale(0.94);
}

.composer-line-icon {
  position: relative;
  display: block;
  width: 24px;
  height: 24px;
  box-sizing: border-box;
}

.composer-plus-icon::before,
.composer-plus-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 2px;
  background: currentColor;
  transform: translate(-50%, -50%);
  border-radius: 2px;
}

.composer-plus-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.composer-mic-icon {
  width: 20px;
  height: 24px;
  border: 2px solid currentColor;
  border-radius: 10px;
  box-sizing: border-box;
}

.composer-mic-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -6px;
  width: 12px;
  height: 7px;
  border-left: 2px solid currentColor;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  border-radius: 0 0 8px 8px;
  transform: translateX(-50%);
}

.composer-mic-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -9px;
  width: 2px;
  height: 4px;
  background: currentColor;
  transform: translateX(-50%);
}

.composer-send-icon {
  width: 22px;
  height: 24px;
}

.composer-send-icon::before,
.composer-send-icon::after {
  content: "";
  position: absolute;
  background: currentColor;
  height: 2px;
  border-radius: 2px;
  transform-origin: right center;
}

.composer-send-icon::before {
  width: 18px;
  right: 2px;
  top: 7px;
  transform: rotate(-42deg);
}

.composer-send-icon::after {
  width: 18px;
  right: 2px;
  bottom: 7px;
  transform: rotate(42deg);
}

.composer-send-button {
  color: #3b82f6;
}

.composer-aira-button {
  width: auto;
  min-width: 44px;
  gap: 5px;
  color: #3b82f6;
}

.composer-aira {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.composer-aira-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.composer-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 8px;
  padding: 0 2px;
}

.composer-attachment {
  position: relative;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 6px 8px;
  border-radius: 12px;
  background: rgba(70, 90, 130, 0.18);
  border: 1px solid rgba(120, 140, 180, 0.22);
  max-width: 100%;
}

.composer-attachment-preview {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  border-radius: 8px;
  object-fit: cover;
  display: block;
}

.composer-attachment-name {
  max-width: 160px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer-attachment-size {
  opacity: 0.6;
  font-size: 11px;
}

.composer-attachment-remove {
  width: 24px;
  height: 24px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-size: 18px;
}

.voice-recording-controls {
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  padding: 8px 14px;
  color: #3b82f6;
  box-sizing: border-box;
}

.voice-recording-cancel,
.voice-record-button {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: #3b82f6;
  cursor: pointer;
}

.voice-recording-cancel {
  font-size: 30px;
  line-height: 1;
}

.voice-waves {
  flex: 1;
  max-width: 180px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.voice-waves i {
  width: 2px;
  height: 12px;
  background: currentColor;
  border-radius: 2px;
  animation: theoVoiceWave 0.85s ease-in-out infinite alternate;
}

.voice-waves i:nth-child(2) { animation-delay: -0.2s; }
.voice-waves i:nth-child(3) { animation-delay: -0.4s; }
.voice-waves i:nth-child(4) { animation-delay: -0.1s; }
.voice-waves i:nth-child(5) { animation-delay: -0.3s; }
.voice-waves i:nth-child(6) { animation-delay: -0.5s; }
.voice-waves i:nth-child(7) { animation-delay: -0.25s; }

@keyframes theoVoiceWave {
  from { height: 7px; }
  to { height: 28px; }
}

.voice-record-lines {
  position: relative;
  width: 20px;
  height: 20px;
}

.voice-record-lines::before,
.voice-record-lines::after {
  content: "";
  position: absolute;
  top: 4px;
  width: 2px;
  height: 12px;
  background: currentColor;
  border-radius: 2px;
}

.voice-record-lines::before {
  left: 6px;
}

.voice-record-lines::after {
  right: 6px;
}

.voice-status {
  min-height: 0;
  padding: 0 14px 5px;
  font-size: 11px;
  opacity: 0.65;
}

.composer-v2.is-recording .composer-content,
.composer-v2.is-recording .composer-controls,
.composer-v2.is-recording .voice-status {
  display: none;
}

.composer-v2.has-content .composer-content {
  padding-bottom: 0;
}

.composer-v2.has-content .composer-aira-button {
  display: none;
}

.composer-v2:not(.has-content) .composer-send-button {
  display: none;
}

.composer-v2.is-recording .voice-recording-controls {
  display: flex;
}

@media (max-width: 520px) {
  .composer-v2 {
    padding: 8px;
  }

  .composer-shell {
    border-radius: 18px;
  }

  .composer-controls {
    min-height: 44px;
  }

  .composer-icon-button {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
  }
}
