  border-radius: 99px;
  background: currentColor;
  transform-origin: center;
  animation: theoComposerLongWave .72s ease-in-out infinite alternate;
}

.composer-v2 .voice-waves i:nth-child(2) { animation-delay: -.12s; }
.composer-v2 .voice-waves i:nth-child(3) { animation-delay: -.24s; }
.composer-v2 .voice-waves i:nth-child(4) { animation-delay: -.36s; }
