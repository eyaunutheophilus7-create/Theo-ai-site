.composer-v2 .voice-waves i:nth-child(6) { animation-delay: -.60s; }
.composer-v2 .voice-waves i:nth-child(7) { animation-delay: -.18s; }

@keyframes theoComposerLongWave {
  from {
    height: 7px;
    opacity: .55;
  }
  to {
    height: 32px;
    opacity: 1;
  }
}

